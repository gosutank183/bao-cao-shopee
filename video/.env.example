# Copy file này thành .env rồi điền giá trị

# Token bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=

# ID Telegram của những người được phép dùng bot, cách nhau bằng dấu phẩy.
# Chưa biết ID? Để trống, chạy bot, nhắn /id cho bot, rồi điền vào đây.
ALLOWED_USER_IDS=

# Nơi gửi video tự động hằng ngày (để trống = gửi cho ID đầu tiên ở ALLOWED_USER_IDS)
TELEGRAM_CHAT_ID=

# ---- Chạy hằng ngày (npm run daily) ----
# Repo báo cáo; đổi thành gosutank183/bao-cao-do-gia-dung cho ngách đồ gia dụng
REPORT_REPO=gosutank183/bao-cao-shopee
REPORT_BRANCH=main
# Số sản phẩm đầu bảng làm video mỗi ngày
DAILY_COUNT=1
# Chỉ cần nếu repo báo cáo là riêng tư (token chỉ đọc)
GITHUB_TOKEN=

# Khóa API Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Giọng đọc Edge-TTS: vi-VN-HoaiMyNeural (nữ) hoặc vi-VN-NamMinhNeural (nam)
TTS_VOICE=vi-VN-HoaiMyNeural
# Tốc độ đọc, ví dụ +10% cho video bán hàng nhanh hơn
TTS_RATE=+10%
# Lệnh chạy edge-tts. Trên Windows nếu báo không tìm thấy, thử: python -m edge_tts
EDGE_TTS_CMD=edge-tts

# Chất lượng render HyperFrames: draft (nhanh, để thử) | standard | high
RENDER_QUALITY=standard
RENDER_FPS=30

# Số video render cùng lúc (máy laptop nên để 1)
RENDER_CONCURRENCY=1
# Số video tối đa được xếp hàng chờ
MAX_QUEUE=5

# Giữ lại thư mục làm việc sau khi render (để debug): true/false
KEEP_WORKDIR=false
